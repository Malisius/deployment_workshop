# ==============================================================================
# Caddyfile - Automatic HTTPS Reverse Proxy
# Caddy automatically issues and renews Let's Encrypt / ZeroSSL certificates!
# ==============================================================================

# Replace {$DOMAIN:localhost} with your actual domain name, e.g. workshop.example.com
{$DOMAIN:localhost} {
    # Reverse proxy to Flask / Gunicorn
    reverse_proxy web:5000 {
        # Health check upstream
        health_uri /healthz?graceful=true
        health_interval 15s
        health_timeout 5s
    }

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Access logs in JSON format
    log {
        output stdout
        format json
    }
}
