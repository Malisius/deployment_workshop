# ==============================================================================
# Deployment Workshop - Environment Configuration
# ==============================================================================

# Application Environment (production, development, testing)
APP_ENV=production
FLASK_ENV=production

# Security Secret Key (Generate a random 32+ byte string in production)
# Example: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-token-in-production

# Server Port (Default is 5000, cloud providers like Heroku/Railway inject $PORT)
PORT=5000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# Option A: Unified Database URL (Heroku, Railway, Render, Fly.io secrets)
# Supported schemas: mysql://, mysql+pymysql://, mysql2://
# ------------------------------------------------------------------------------
DATABASE_URL=mysql+pymysql://workshop_user:workshop_secret_pass@127.0.0.1:3306/deployment_workshop

# ------------------------------------------------------------------------------
# Option B: Individual MySQL Parameters (Docker Compose, VPS, Bare Metal)
# Used if DATABASE_URL is not set
# ------------------------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=workshop_user
MYSQL_PASSWORD=workshop_secret_pass
MYSQL_DATABASE=deployment_workshop
MYSQL_ROOT_PASSWORD=workshop_root_pass

# Optional SSL CA certificate path (PlanetScale, AWS RDS, Aiven)
# MYSQL_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# Database connection pool recycling (in seconds) to prevent stale socket drops
DB_POOL_RECYCLE=280
